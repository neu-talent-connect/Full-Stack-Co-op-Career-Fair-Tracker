generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id               String   @id @default(cuid())
  userId           String

  company          String
  title            String
  status           String
  interest         Int
  dateApplied      String?
  deadline         String?
  notes            String?  @db.Text

  jobId            String?
  location         String?
  salary           String?
  applicationCycle String?
  datePosted       String?
  contact          String?
  contactEmail     String?
  contactPhone     String?
  resume           String?
  coverLetter      String?
  url              String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([deadline])
}

model Company {
  id          String   @id @default(cuid())
  userId      String

  name        String
  industry    String?
  interest    Int
  booth       String?
  recruiter   String?
  position    String?
  optFriendly String?
  deadline    String?
  website     String?
  location    String?
  status      String?
  notes       String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([userId])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String

  name      String
  company   String?
  position  String?
  email     String?
  linkedin  String?
  phone     String?
  type      String
  strength  String
  ranking   Int?
  isPinned  Boolean? @default(false)
  notes     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isPinned])
}

model FollowUp {
  id        String   @id @default(cuid())
  userId    String

  company   String
  contact   String?
  type      String
  dueDate   String
  priority  String
  status    String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model ResearchContact {
  id             String   @id @default(cuid())
  userId         String

  name           String
  linkedin       String?
  companies      Json     @default("[]")
  interest       Int
  outreachStatus String
  notes          String?  @db.Text

  createdAt      DateTime @default(now())

  @@index([userId])
}

model Interview {
  id           String   @id @default(cuid())
  userId       String

  jobId        String
  company      String
  position     String
  type         String
  date         String
  time         String?
  location     String?
  interviewers String?
  notes        String?  @db.Text
  status       String

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@index([status])
}
