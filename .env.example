# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own Supabase project values.
# `.env` is gitignored — never commit real secrets. Set the SAME variables in
# Vercel → Settings → Environment Variables for the deployed app.
# ---------------------------------------------------------------------------

# Supabase project (Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"

# Database connection strings (Connect button → ORMs tab)
# Use the POOLER host (...pooler.supabase.com), NOT db.<ref>.supabase.co (IPv6-only, fails on Vercel).
# URL-encode special chars in the password: ! -> %21, @ -> %40, # -> %23.

# Transaction pooler (port 6543) — app runtime queries. Keep ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — used by Prisma ONLY for migrations / db push.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Authentication Control
# "true" enables login/signup; "false" shows maintenance mode.
NEXT_PUBLIC_ALLOW_AUTH="false"

# Resend (Email Service) — optional, for production confirmation emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# ---------------------------------------------------------------------------
# Local dev note: campus/corporate networks often block outbound DB ports
# (5432/6543). If local connections fail with P1001 "can't reach", use a VPN.
# This does NOT affect Vercel or end users.
# ---------------------------------------------------------------------------
